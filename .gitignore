# Секреты — ключи только в GitHub Secrets, в репозиторий не попадают никогда
.env
.env.*
*.key
*_secret*
secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node
node_modules/

