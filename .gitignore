# Секреты — ключи только в GitHub Secrets, в репозиторий не попадают никогда
.env
.env.*
*.key
*_secret*
secrets/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node
node_modules/

# Сырые страницы (gzip) — хранятся локально в прогоне, в git не коммитятся
# (открытый вопрос к заказчику: нужна ли архивация raw/ в git — см. PROGRESS.md)
raw/

# Локальные артефакты
*.log
.DS_Store
.claude/settings.local.json

# hyperresearch: волатильные файлы SQLite не коммитятся
.hyperresearch/*.db-shm
.hyperresearch/*.db-wal

# Выгрузки прошлых дат не коммитятся (2026-09-04: файл data/osint.db дорос
# до 101 МБ и упёрся в жёсткий лимит GitHub 100 МБ; каждая копия .xlsx
# ложилась в историю навсегда — 450 МБ за неделю). В репозитории живёт
# только СВЕЖАЯ выгрузка каждого вида; прошлые лежат в артефактах прогонов
# (30 дней) и у заказчика.
output/Тест40_2026-08-*.xlsx
output/Тест40_2026-09-0[123].xlsx
output/Прайсы_2026-*.xlsx
output/Прайсы_обкатка40_*.xlsx
output/Прайсы_профиль_2026-09-03.xlsx
output/ЧК_ОСИНТ_сводный_2026-09-03.xlsx
